# -----------------------------------------------------------------------------
# Oppora Local Environment Template
# -----------------------------------------------------------------------------
# For normal local usage (non-admin), you only need DATABASE_URL + JWT_SECRET_KEY.
# Everything else is optional and feature-specific.

# Required: Local Postgres URL (works with docker-compose defaults).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hack_hunt

# Required: JWT signing secret for auth tokens.
# Generate a strong value, for example:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production

# Optional: Browser origins allowed to call backend API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# -----------------------------------------------------------------------------
# Optional: AI Features (ScrollAI + Cold Email profile extraction + free-tier AI)
# -----------------------------------------------------------------------------
# Get this from your Ollama Cloud account.
COLDEMAIL_PROFILE_API_KEY=

# Optional overrides for profile extraction endpoint/model.
COLDEMAIL_PROFILE_BASE_URL=https://ollama.com/v1
COLDEMAIL_PROFILE_MODEL=gemma4:31b-cloud

# Optional: Local Ollama URL used for embeddings and local chat flows.
EMBEDDING_OLLAMA_BASE_URL=http://localhost:11434


# -----------------------------------------------------------------------------
# Optional: Save cloud provider keys in Settings page (encrypted at rest)
# -----------------------------------------------------------------------------
# Needed only if users will store Gemini/OpenAI/Anthropic/Ollama Cloud keys.
# Generate once:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_KEY_ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
# Optional: Cold Email sending via SMTP
# -----------------------------------------------------------------------------
# Needed only for the "Send" action in ScribeAI drafts.
#
# Fill these with your email provider's SMTP settings:
# - SMTP_HOST: the mail server host (for example, smtp.gmail.com)
# - SMTP_PORT: usually 587 for STARTTLS, or 465 if your provider requires SSL/TLS
# - SMTP_USERNAME: the login account for the mailbox
# - SMTP_PASSWORD: the mailbox password or app password
# - SMTP_FROM_EMAIL: the sender address shown in outgoing mail
#
# The recipient email is NOT stored here. It is entered when approving/sending each draft.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true


# -----------------------------------------------------------------------------
# Optional: Admin and deployment configuration
# -----------------------------------------------------------------------------
# If set, users can pass this during signup to create admin account.
ADMIN_SIGNUP_KEY=

# Supabase override. If set, this takes precedence over DATABASE_URL.
# Example:
# postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# Optional sslmode override when using SUPABASE_DB_URL.
# If SUPABASE_DB_URL is set and DATABASE_SSLMODE is empty, sslmode=require is auto-applied.
DATABASE_SSLMODE=

# Optional auth/session tuning.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional: 11-class news topic model. Copy the exported DistilBERT files to
# news_distilbert_model/ before enabling this setting. Inference uses the title
# plus the start of the article, limited to the 128 tokens used in training.
NEWS_TOPIC_MODEL_DIR=
NEWS_TOPIC_DEFAULT_LABEL=general
